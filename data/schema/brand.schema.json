{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/brand.schema.json",
  "title": "Brand",
  "type": "object",
  "additionalProperties": false,
  "required": ["colors", "fonts", "logoText"],
  "properties": {
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "text", "background"],
      "properties": {
        "primary": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" },
        "secondary": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" },
        "text": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" },
        "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" }
      }
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "body"],
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 }
      }
    },
    "logoText": { "type": "string" }
  }
}
