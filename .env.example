# Copy to .env (gitignored) to fill in contact details without committing them to
# data/resume.json. Any var left unset/empty keeps whatever is already in resume.json.
# See @my-cv/shared's applyConfidentialOverrides (packages/shared/src/confidential.ts).

RESUME_PHONE=
RESUME_EMAIL=
RESUME_ADDRESS=
RESUME_CITY=
RESUME_COUNTRY_CODE=
RESUME_TELEGRAM=
